"""
Final Project: Student Result Management System
------------------------------------------------
Features:
1. Add student records (name, roll number, marks).
2. Store data in a file (persistent storage).
3. Load and display all student records.
4. Calculate average, grade, and pass/fail status.
5. Search for a student by roll number.
6. Generate a simple report.
"""

import os

# -------------------------------
# Student Class
# -------------------------------
class Student:
    def __init__(self, roll_no, name, marks):
        self.roll_no = roll_no
        self.name = name
        self.marks = marks  # list of marks

    def average(self):
        return sum(self.marks) / len(self.marks)

    def grade(self):
        avg = self.average()
        if avg >= 90:
            return "A"
        elif avg >= 75:
            return "B"
        elif avg >= 50:
            return "C"
        else:
            return "F"

    def status(self):
        return "Pass" if self.average() >= 50 else "Fail"

    def __str__(self):
        return f"{self.roll_no},{self.name},{'|'.join(map(str, self.marks))}"

    @staticmethod
    def from_string(data_line):
        parts = data_line.strip().split(",")
        roll_no = parts[0]
        name = parts[1]
        marks = list(map(int, parts[2].split("|")))
        return Student(roll_no, name, marks)

# -------------------------------
# File Handling Functions
# -------------------------------
FILE_NAME = "students.txt"

def save_student(student):
    with open(FILE_NAME, "a") as f:
        f.write(str(student) + "\n")

def load_students():
    students = []
    if os.path.exists(FILE_NAME):
        with open(FILE_NAME, "r") as f:
            for line in f:
                if line.strip():
                    students.append(Student.from_string(line))
    return students

# -------------------------------
# Core Features
# -------------------------------
def add_student():
    roll_no = input("Enter Roll Number: ").strip()
    name = input("Enter Name: ").strip()
    try:
        marks = list(map(int, input("Enter marks (comma-separated): ").split(",")))
    except ValueError:
        print("Invalid input. Marks must be integers.")
        return
    student = Student(roll_no, name, marks)
    save_student(student)
    print("Student added successfully.")

def display_students():
    students = load_students()
    if not students:
        print("No student records found.")
        return
    for s in students:
        print(f"Roll: {s.roll_no}, Name: {s.name}, Avg: {s.average():.2f}, Grade: {s.grade()}, Status: {s.status()}")

def search_student():
    roll_no = input("Enter Roll Number to search: ").strip()
    students = load_students()
    for s in students:
        if s.roll_no == roll_no:
            print(f"Found → Roll: {s.roll_no}, Name: {s.name}, Avg: {s.average():.2f}, Grade: {s.grade()}, Status: {s.status()}")
            return
    print("Student not found.")

def generate_report():
    students = load_students()
    if not students:
        print("No records available.")
        return
    total = len(students)
    passed = sum(1 for s in students if s.status() == "Pass")
    failed = total - passed
    print("\n--- Student Report ---")
    print("Total Students:", total)
    print("Passed:", passed)
    print("Failed:", failed)
    print("Class Average:", sum(s.average() for s in students) / total if total > 0 else 0)

# -------------------------------
# Main Menu
# -------------------------------
def main():
    while True:
        print("\n===== Student Result Management System =====")
        print("1. Add Student")
        print("2. Display All Students")
        print("3. Search Student by Roll No")
        print("4. Generate Report")
        print("5. Exit")

        choice = input("Choose an option (1-5): ").strip()

        if choice == "1":
            add_student()
        elif choice == "2":
            display_students()
        elif choice == "3":
            search_student()
        elif choice == "4":
            generate_report()
        elif choice == "5":
            print("Exiting. Goodbye.")
            break
        else:
            print("Invalid choice. Please select 1-5.")

if __name__ == "__main__":
    main()
